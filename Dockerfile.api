# =============================================================================
# JARVI 2.0.18 | Dockerfile.api CON INVALIDACIÓN DE CACHÉ Y RENOMBRADO
# =============================================================================

# ARG que actúa como "cache buster". Cambia este valor en cada deploy.
ARG CACHE_BUST=20260727_02

FROM python:3.11-slim

# Dependencias del sistema
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libstdc++6 \
    libgcc-s1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# =============================================================================
# INVALIDACIÓN DE CACHÉ
# =============================================================================
RUN echo "Cache bust version: ${CACHE_BUST}"

# Instalación de dependencias Python
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Verificación determinística
RUN python -c "import langfuse, asyncpg, redis; print('✅ Dependencias críticas OK')"

# Copiar código fuente
COPY . .

# Verificación explícita de que el archivo nuevo tiene los prints de diagnóstico
RUN grep -q "🔍 Respuesta final:" /app/api_new.py && echo "✅ api_new.py contiene diagnóstico" || echo "❌ api_new.py NO contiene diagnóstico"
RUN grep -q "ON CONFLICT (thread_id)" /app/db_client.py && echo "✅ db_client.py tiene UPSERT" || echo "❌ db_client.py antiguo"

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD python -c "import langfuse, asyncpg, redis" || exit 1

EXPOSE 8080

# =============================================================================
# CMD usando el nuevo nombre
# =============================================================================
CMD ["uvicorn", "api_new:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1"]
